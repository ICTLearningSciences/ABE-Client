{
  "name": "abe-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --port 8000",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\"",
    "cy:open": "npx cypress open",
    "test:audit": "npm audit --production --audit-level=moderate",
    "test:lint": "eslint src --ext ts --ext tsx --ext js --ext jsx --max-warnings 0",
    "test:types": "tsc --noEmit",
    "test:format": "prettier --check \"src/**/*.{js,ts,tsx}\"",
    "license:fix": "license-check-and-add remove -f license-config.json && license-check-and-add add -f license-config.json",
    "test:license": "license-check-and-add check -f license-config.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/generative-ai": "^0.24.1",
    "@hugerte/hugerte-react": "^2.0.2",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-data-grid": "^9.10.1",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react": "^10.69.0",
    "axios": "^1.19.0",
    "copy-to-clipboard": "^4.0.2",
    "framer-motion": "^12.43.0",
    "jsonschema": "^1.5.0",
    "lodash": "^4.18.1",
    "mitt": "^3.0.1",
    "motion": "^12.43.0",
    "openai": "^7.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-draggable": "^4.7.1",
    "react-flip-move": "^3.0.5",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "react-oidc-context": "^3.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "redux-logger": "^3.0.6",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "showdown": "^2.1.0",
    "styled-components": "^6.4.4",
    "textdiff-create": "^1.1.11",
    "tss-react": "^4.9.21",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cypress-dotenv": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/redux-logger": "^3.0.13",
    "@types/showdown": "^2.0.6",
    "@types/textdiff-create": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "cypress": "^15.19.0",
    "cypress-dotenv": "^3.0.1",
    "cypress-localstorage-commands": "^2.3.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "license-check-and-add": "^4.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
